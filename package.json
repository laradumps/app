{
    "name": "laradumps",
    "version": "4.2.1",
    "private": false,
    "description": "LaraDumps a friendly app designed to boost your PHP coding and debugging experience. https://github.com/laradumps/app",
    "author": "Luan Freitas <luanfreitas10@protonmail.com>",
    "main": "dist/main.cjs",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"vite\" \"node build.js --dev && electron .\"",
        "build": "vite build && node build.js --prod",
        "build-win": "npm run build && electron-builder --win",
        "build-mac": "npm run build && electron-builder --mac --universal",
        "build-linux": "npm run build && electron-builder --linux",
        "publish-win": "npm run build && electron-builder --publish always --win",
        "publish-mac": "npm run build && electron-builder --publish always --mac --universal",
        "publish-linux": "npm run build && electron-builder --publish always --linux",
        "format": "prettier . --write --single-attribute-per-line"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@heroicons/vue": "^2.2.0",
        "@highlightjs/vue-plugin": "^2.1.0",
        "@tailwindcss/postcss": "^4.0.17",
        "@tailwindcss/typography": "^0.5.16",
        "@tailwindcss/vite": "^4.0.17",
        "@types/node": "22.13.14",
        "auto-launch": "^5.0.6",
        "autoprefixer": "^10.4.21",
        "axios": "^1.8.4",
        "body-parser": "^1.20.3",
        "chart.js": "^4.4.8",
        "chokidar": "^4.0.3",
        "cors": "^2.8.5",
        "electron-dl": "^4.0.0",
        "electron-json-storage": "^4.6.0",
        "electron-localshortcut": "^3.2.1",
        "electron-store": "^10.0.1",
        "electron-updater": "6.6.2",
        "electron-window-state": "^5.0.3",
        "eslint-config-prettier": "10.1.1",
        "express": "^4.21.2",
        "highlight.js": "^11.11.1",
        "hotkeys-js": "^3.13.9",
        "humanize-duration": "^3.32.1",
        "js-confetti": "^0.12.0",
        "js-yaml": "^4.1.0",
        "moment": "^2.30.1",
        "pinia": "^3.0.1",
        "postcss-import": "^16.1.0",
        "splitpanes": "^4.0.3",
        "sql-formatter": "^15.5.2",
        "ssh2": "^1.16.0",
        "tippy.js": "^6.3.7",
        "typescript": "*",
        "vue": "3.5.13",
        "vue-i18n": "9.4.1",
        "vue-json-pretty": "^2.4.0",
        "vue-router": "^4.5.0",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "@types/electron": "^1.6.10",
        "@types/electron-json-storage": "^4.5.4",
        "@types/humanize-duration": "^3.27.4",
        "@types/ssh2": "^1.15.4",
        "@vitejs/plugin-vue": "5.2.3",
        "concurrently": "^9.1.2",
        "daisyui": "^5.0.19",
        "electron": "^32.1.0",
        "electron-builder": "^25.1.8",
        "esbuild": "^0.25.1",
        "eslint-plugin-prettier": "5.2.5",
        "postcss": "8.5.3",
        "prettier": "3.5.3",
        "tailwindcss": "^4.1.4",
        "vite": "^6.2.3"
    },
    "ts-standard": {
        "project": "./tsconfig.json"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/laradumps/app.git"
    },
    "bugs": {
        "url": "https://github.com/laradumps/app/issues"
    },
    "prettier": {
        "trailingComma": "none",
        "printWidth": 200
    },
    "build": {
        "appId": "com.laradumps.app",
        "productName": "LaraDumps",
        "files": [
            "**/*",
            "!node_modules${/*}"
        ],
        "extraResources": [
            "build/*"
        ],
        "extraFiles": [
            "build/**/*"
        ],
        "publish": {
            "provider": "github",
            "owner": "laradumps",
            "repo": "app",
            "private": false
        },
        "directories": {
            "output": "release"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "installerSidebar": "./src/img/installerSidebar.bmp",
            "installerIcon": "./src/img/icon.ico"
        },
        "win": {
            "icon": "./src/img/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "ia32",
                        "x64"
                    ]
                }
            ]
        },
        "linux": {
            "executableName": "laradumps",
            "description": "LaraDumps a friendly app designed to boost your PHP coding and debugging experience. https://github.com/laradumps/app",
            "icon": "./build/icon.icns",
            "target": [
                "AppImage",
                "snap"
            ],
            "desktop": {
                "Name": "LaraDumps",
                "icon": "./build/icon.icns",
                "Comment": "LaraDumps a friendly app designed to boost your Laravel PHP coding and debugging experience. https://github.com/laradumps/app",
                "Categories": "Development"
            },
            "maintainer": "Luan Freitas",
            "category": "Development"
        },
        "deb": {
            "packageCategory": "Development",
            "depends": [
                "gconf2",
                "gconf-service",
                "libnotify4",
                "libappindicator1",
                "libxtst6",
                "libnss3"
            ]
        },
        "mac": {
            "darkModeSupport": true
        },
        "dmg": {
            "title": "${productName} ${version}",
            "icon": "./build/icon.icns",
            "background": "./src/img/install_dmg.png",
            "contents": [
                {
                    "x": 110,
                    "y": 150
                },
                {
                    "x": 240,
                    "y": 150,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        }
    }
}
